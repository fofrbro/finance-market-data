table silver_cours
	lineageTag: 355a95c1-2c4b-40ad-9050-5ea85fd0e93f
	sourceLineageTag: [dbo].[silver_cours]

	measure 'Rendement moyen' = AVERAGE(silver_cours[rendement_usd])
		lineageTag: 90fcdc9b-9a73-449d-a5f2-832f32cde81f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rendement annualisé' = [Rendement moyen] * 252
		lineageTag: 79287e37-8d0a-4edc-a1cf-c181dde3c4da

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volatilité annualisée' = STDEV.P(silver_cours[rendement_usd]) * SQRT(252)
		lineageTag: 116ee14c-2bef-4768-a5cc-fa9ced9e39bd

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Sharpe = DIVIDE([Rendement annualisé] - 0.025, [Volatilité annualisée])
		lineageTag: a9cd7928-c69f-4cf5-b68b-e894341b5b47

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

